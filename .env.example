# SIMPONI Environment Variables Configuration Example
# Copy this file to .env and adjust values if necessary

# Database Configuration (PostgreSQL 16)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=simponi_db
DB_USER=simponi_user
DB_PASSWORD=simponi_secure_pass_123

# Spring Application Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Initial Super Admin (Created during Flyway migration / startup if not present)
INITIAL_ADMIN_EMAIL=admin@simponi.local
INITIAL_ADMIN_PASSWORD=AdminPass123!

